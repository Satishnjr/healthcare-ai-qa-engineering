{
  "name": "careflow-automation",
  "version": "1.13.0",
  "private": true,
  "description": "Playwright + Cucumber BDD automation foundation for CareFlow Health",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "smoke:chromium": "cross-env BROWSER=chromium cucumber-js --config cucumber.js --tags \"@smoke\"",
    "smoke:firefox": "cross-env BROWSER=firefox cucumber-js --config cucumber.js --tags \"@smoke\"",
    "smoke:webkit": "cross-env BROWSER=webkit cucumber-js --config cucumber.js --tags \"@smoke\"",
    "smoke:all": "npm run smoke:chromium && npm run smoke:firefox && npm run smoke:webkit",
    "report:html": "node src/reporters/generate-cucumber-report.js"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.0.1",
    "@playwright/test": "^1.54.2",
    "@types/node": "^22.13.1",
    "cross-env": "^7.0.3",
    "multiple-cucumber-html-reporter": "^3.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
